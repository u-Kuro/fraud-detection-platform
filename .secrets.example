# GitHub
# > Read-only permissions for contents, metadata, and pull-requests (github.com/settings/personal-access-tokens)
GITHUB_TOKEN=your-github-token

# Slack
SLACK_CHANNEL_ID=your-channel-id
SLACK_APP_LEVEL_TOKEN=your-app-level-token
SLACK_BOT_USER_OAUTH_TOKEN=your-bot-user-oauth-token
SLACK_SIGNING_SECRET=your-signing-secret

# AWS Credentials/Configurations
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=admin
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://ministack:4566 # MiniStack container URL

# Kubernetes
NAMESPACE=mle

# Secrets Manager
SECRET_PATH=mle

# SSM
PARAMETER_PATH=mle